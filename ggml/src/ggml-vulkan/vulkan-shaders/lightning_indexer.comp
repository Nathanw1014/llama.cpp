#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

layout(constant_id = 0) const uint SUBGROUP_SIZE = 64;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer QBuf    { float     data_q[];   };
layout(binding = 1) readonly  buffer KBuf    { float16_t data_k[];   };
layout(binding = 2) readonly  buffer WBuf    { float     data_w[];   };
layout(binding = 3) readonly  buffer MaskBuf { float16_t data_m[];   };
layout(binding = 4) writeonly buffer DstBuf  { float     data_dst[]; };

layout(push_constant) uniform Parameters {
    uint n_kv;
    uint n_batch;
    uint n_stream;
    uint nem3;
    uint nb1;
    uint nb3;
    uint nbq1;
    uint nbq2;
    uint nbq3;
    uint nbk2;
    uint nbk3;
    uint nbw1;
    uint nbw3;
    uint nbm1;
    uint nbm3;
} p;

const uint K_PER_GROUP = 8;
const uint N_HEAD = 64;

// the indexer head dimension. supports_op rejects anything else, so it is safe to fix here.
const uint HEAD_DIM = 128;

// each lane covers a strided slice of the head dimension, so SUBGROUP_SIZE must divide
// HEAD_DIM: 2 elements per lane at wave64, 4 at wave32. supports_op enforces the same
// divisibility before this pipeline is selected.
const uint ELEM_PER_LANE = HEAD_DIM / SUBGROUP_SIZE;

void main() {
    const uint lane = gl_SubgroupInvocationID;
    const uint token = gl_WorkGroupID.y;
    const uint stream = gl_WorkGroupID.z;
    const uint kv_base = gl_WorkGroupID.x * K_PER_GROUP;

    if (token >= p.n_batch || stream >= p.n_stream) {
        return;
    }

    float kvals[K_PER_GROUP * ELEM_PER_LANE];
    [[unroll]] for (uint j = 0; j < K_PER_GROUP; ++j) {
        const uint kv = kv_base + j;
        if (kv < p.n_kv) {
            const uint k_base = stream * p.nbk3 + kv * p.nbk2;
            [[unroll]] for (uint e = 0; e < ELEM_PER_LANE; ++e) {
                kvals[j * ELEM_PER_LANE + e] = float(data_k[k_base + lane + e * SUBGROUP_SIZE]);
            }
        } else {
            [[unroll]] for (uint e = 0; e < ELEM_PER_LANE; ++e) {
                kvals[j * ELEM_PER_LANE + e] = 0.0;
            }
        }
    }

    float score[K_PER_GROUP];
    [[unroll]] for (uint j = 0; j < K_PER_GROUP; ++j) {
        score[j] = 0.0;
    }

    for (uint head = 0; head < N_HEAD; ++head) {
        const uint q_base = stream * p.nbq3 + token * p.nbq2 + head * p.nbq1;
        float qvals[ELEM_PER_LANE];
        [[unroll]] for (uint e = 0; e < ELEM_PER_LANE; ++e) {
            qvals[e] = data_q[q_base + lane + e * SUBGROUP_SIZE];
        }
        const float weight = data_w[stream * p.nbw3 + token * p.nbw1 + head];

        [[unroll]] for (uint j = 0; j < K_PER_GROUP; ++j) {
            // accumulated in the same order as the wave64 q0*k0 + q1*k1 form, so the
            // wave64 result stays bit-identical
            float acc = 0.0;
            [[unroll]] for (uint e = 0; e < ELEM_PER_LANE; ++e) {
                acc += qvals[e] * kvals[j * ELEM_PER_LANE + e];
            }
            const float qk = subgroupAdd(acc);
            if (lane == 0) {
                score[j] += max(qk, 0.0) * weight;
            }
        }
    }

    if (lane == 0) {
        const uint mask_base = (stream % p.nem3) * p.nbm3 + token * p.nbm1;
        const uint dst_base = stream * p.nb3 + token * p.nb1;
        [[unroll]] for (uint j = 0; j < K_PER_GROUP; ++j) {
            const uint kv = kv_base + j;
            if (kv < p.n_kv) {
                data_dst[dst_base + kv] = score[j] + float(data_m[mask_base + kv]);
            }
        }
    }
}
