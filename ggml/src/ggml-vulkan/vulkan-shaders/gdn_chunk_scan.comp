#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

// Chunked gated delta net, part 2 of 2: sequential over chunks of CL tokens, after gdn_chunk_prep.comp.
// The v columns of the state S (k x v) evolve independently: every wave32 owns 16 columns of one value head,
// NW waves per workgroup, 8 / NW workgroups per head. Per chunk:
//   R = V - diag(gam) K S,  Delta = T R
//   O = scale diag(gam) Q S + P Delta
//   S' = gam_last S + K^T diag(dec) Delta
// S stays in f32 WMMA accumulators; it is fed back as an f16 B operand by swapping rows between the two
// half-waves (RDNA3 layout: an f32 accumulator lane L holds column L%16, rows 2i + L/16; a B operand lane L
// holds column L%16, rows 0..15). The A operands (Q, K, K^T, T, P) are stored by the prep in fragment order,
// so a lane's fragment is two adjacent 16-byte units, read straight from the scratch (one wave per workgroup:
// 384 waves at the Flash-Next shape). USE_LDS (probe, GGML_VK_GDN_CHUNK_SCAN=1) stages the chunk's K, K^T, T,
// P and gate factors per workgroup in LDS from registers loaded one chunk ahead instead: equal in-model,
// 6% slower op-level, 1.5x slower at 4 heads. Operands f16, accumulation f32: not bit-identical to the
// sequential kernel. Idea from halo-box/strix-llama.cpp#91 (Gaetan Puleo).

layout(constant_id = 0) const uint WGT = 128;        // NW waves of 32
#ifndef KSPLIT
#define KSPLIT 1 // waves sharing one 16-column tile, each with KT / KSPLIT of the state's k blocks (KSPLIT 2: WGT 64)
#endif
#ifndef CPW
#define CPW 1    // 16-column state tiles per wave (CPW 2: each A operand load feeds two tiles; not with USE_LDS)
#endif
const uint NW = WGT / 32;

#define S_V 128
#define CL 32
#define NT (CL / 16)
#define KT (S_V / 16)
#define QKU (3 * CL * S_V / 2)
#define TPU (CL * CL + 2 * CL)

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint H;
    uint n_tokens;
    uint n_seqs;
    uint s_off;
    uint sq1, sq2, sq3;
    uint sv1, sv2, sv3;
    uint sb1, sb2, sb3;
    uint neq1, rq3;
    float scale;
    uint K;
    uint nch;
};

layout(binding = 0) readonly  buffer VBuf     { float data_v[];     };
layout(binding = 1) readonly  buffer StateBuf { float data_state[]; };
layout(binding = 2)           buffer DstBuf   { float data_dst[];   };
layout(binding = 3) readonly  buffer ScrBuf   { uvec4 scr4[];       };

// one chunk in 16-byte units, fragment order (tile (rb, cb) of 32 units, lane row r at +2r):
//   q/k block: Qh [0, 512), Kh [512, 1024), KhT [1024, 1536);  T/P block: T [0, 128), P [128, 256), gam/dec [256, 272)
#define G_K   512
#define G_KT  1024
#define G_P   128
#define G_G   256
#define QFRAG(j, kt)  (((j) * KT + (kt)) * 32)       // Qh/Kh tile (row block j, k block kt)
#define KTFRAG(kt, j) (((kt) * NT + (j)) * 32)       // KhT tile (k block kt, t block j)
#define TFRAG(j, i)   (((j) * NT + (i)) * 32)        // T/P tile

#ifdef USE_LDS
// LDS: Kh, KhT, T, P, gam/dec in the global order (20 KB = 3 workgroups per CU; staging Q as well, 29 KB,
// measured slower)
#define L_K   0
#define L_KT  (L_K + 512)
#define L_T   (L_KT + 512)
#define L_P   (L_T + 128)
#define L_G   (L_P + 128)
#define L_N   (L_G + 16)
#define L_SRC (G_K - L_K)                            // global q/k block unit of LDS unit 0
shared uvec4 L[L_N];
#define A_K(u)  L[L_K + (u)]
#define A_KT(u) L[L_KT + (u)]
#define A_T(u)  L[L_T + (u)]
#define A_P(u)  L[L_P + (u)]
float gd(uint i) { return uintBitsToFloat(L[L_G + i / 4][i % 4]); }   // gam [0, CL), dec [CL, 2CL)
#define A_Q(u)  scr4[qk4 + (u)]
#else
#define A_K(u)  scr4[qk4 + G_K + (u)]
#define A_KT(u) scr4[qk4 + G_KT + (u)]
#define A_T(u)  scr4[tp4 + (u)]
#define A_P(u)  scr4[tp4 + G_P + (u)]
#define gd(i)   uintBitsToFloat(scr4[tp4 + G_G + (i) / 4][(i) % 4])
#define A_Q(u)  scr4[qk4 + (u)]
#endif

#define ACC coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
#define MATA coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define MATB coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>

// accumulator element i of this lane: row AROW(i) of the tile, column lr
#define AROW(i) (2 * (i) + hi)

// A fragment from two 16-byte units (16 halves of this lane's row)
#define SET_A(a, x0_, x1_) { \
    f16vec2 v_; \
    v_ = unpackFloat2x16(x0_.x); a[0]  = v_.x; a[1]  = v_.y; \
    v_ = unpackFloat2x16(x0_.y); a[2]  = v_.x; a[3]  = v_.y; \
    v_ = unpackFloat2x16(x0_.z); a[4]  = v_.x; a[5]  = v_.y; \
    v_ = unpackFloat2x16(x0_.w); a[6]  = v_.x; a[7]  = v_.y; \
    v_ = unpackFloat2x16(x1_.x); a[8]  = v_.x; a[9]  = v_.y; \
    v_ = unpackFloat2x16(x1_.y); a[10] = v_.x; a[11] = v_.y; \
    v_ = unpackFloat2x16(x1_.z); a[12] = v_.x; a[13] = v_.y; \
    v_ = unpackFloat2x16(x1_.w); a[14] = v_.x; a[15] = v_.y; }
#define LOAD_A(a, SRC, frag) { const uvec4 y0_ = SRC((frag) + la); const uvec4 y1_ = SRC((frag) + la + 1); SET_A(a, y0_, y1_) }

// f32 accumulator -> f16 B operand of the same 16x16 tile: rows 4m+hi, 4m+2+hi are packed into one dword,
// swapped with the other half-wave, and interleaved into rows 4m..4m+3. (A hi/lo f16 split of S, R and
// Delta changed neither the test NMSE nor the Flash-Next KLD: the error is set by the f16 Q/K/T/P.)
#define TO_B(b, acc) { \
    [[unroll]] for (uint m_ = 0; m_ < 4; m_++) { \
        const uint own_ = packFloat2x16(f16vec2(acc[2 * m_], acc[2 * m_ + 1])); \
        const uint oth_ = subgroupShuffleXor(own_, 16); \
        const f16vec2 ev_ = unpackFloat2x16(hi == 0 ? own_ : oth_); \
        const f16vec2 od_ = unpackFloat2x16(hi == 0 ? oth_ : own_); \
        b[4 * m_]     = ev_.x; \
        b[4 * m_ + 1] = od_.x; \
        b[4 * m_ + 2] = ev_.y; \
        b[4 * m_ + 3] = od_.y; \
    } }

#if KSPLIT == 2
// partial K S / Q S exchange: [chunk parity][wave][tile (KS j, QS j)][element][lane]
shared float XS[2][2][2 * NT][8][32];
void main() {
    const uint lane  = gl_SubgroupInvocationID;
    const uint lr    = lane % 16;
    const uint hi    = lane / 16;
    const uint la    = 2 * lr;
    const uint w     = gl_SubgroupID;                // this wave's k half
    const uint ow    = 1 - w;
    const uint KH    = KT / 2;
    const uint h     = gl_WorkGroupID.x / 8;
    const uint seq   = gl_WorkGroupID.y;
    const uint iq1   = h % neq1;
    const uint v0    = (gl_WorkGroupID.x % 8) * 16;

    const uint state_base = (seq * H + h) * S_V * S_V + (v0 + lr) * S_V;
    const uint v_lane     = seq * sv3 + h * sv1 + v0 + lr + hi * sv2;
    const uint o_lane     = (seq * n_tokens * H + h) * S_V + v0 + lr + hi * (S_V * H);
    const uint qk_base4   = (seq * nch * neq1 + iq1) * (QKU / 4);
    const uint tp_base4   = (n_seqs * nch * neq1 * QKU + (seq * nch * H + h) * TPU) / 4;

    ACC S[KT / 2];
    [[unroll]] for (uint q = 0; q < KH; q++) {
        [[unroll]] for (uint i = 0; i < 8; i++) {
            S[q][i] = data_state[state_base + (w * KH + q) * 16 + AROW(i)];
        }
    }

    for (uint c = 0; c < nch; c++) {
        const uint t0  = c * CL;
        const uint qk4 = qk_base4 + c * neq1 * (QKU / 4);
        const uint tp4 = tp_base4 + c * H * (TPU / 4);
        const uint par = c & 1;
        float vv[NT][8];
        [[unroll]] for (uint j = 0; j < NT; j++) {
            [[unroll]] for (uint i = 0; i < 8; i++) {
                const uint t = t0 + 16 * j + 2 * i;
                vv[j][i] = data_v[v_lane + min(t, n_tokens - 1 - hi) * sv2];
            }
        }
        const float gam_last = gd(CL - 1);

        // phase 1 over this wave's k blocks, then add the other wave's partial sums
        ACC KS[NT], QS[NT];
        [[unroll]] for (uint j = 0; j < NT; j++) {
            KS[j] = ACC(0.0);
            QS[j] = ACC(0.0);
        }
        [[unroll]] for (uint q = 0; q < KH; q++) {
            const uint kt = w * KH + q;
            MATB sb;
            TO_B(sb, S[q]);
            S[q] = S[q] * gam_last;
            [[unroll]] for (uint j = 0; j < NT; j++) {
                MATA a;
                LOAD_A(a, A_K, QFRAG(j, kt));
                KS[j] = coopMatMulAdd(a, sb, KS[j]);
                LOAD_A(a, A_Q, QFRAG(j, kt));
                QS[j] = coopMatMulAdd(a, sb, QS[j]);
            }
        }
        [[unroll]] for (uint j = 0; j < NT; j++) {
            [[unroll]] for (uint i = 0; i < 8; i++) {
                XS[par][w][j][i][lane]      = KS[j][i];
                XS[par][w][NT + j][i][lane] = QS[j][i];
            }
        }
        barrier();
        [[unroll]] for (uint j = 0; j < NT; j++) {
            [[unroll]] for (uint i = 0; i < 8; i++) {
                // the same sum order in both waves (k half 0 + k half 1), so they agree bit for bit; the own half stays in
                // registers (reading it back from LDS as well measured 1677 vs 1547 us per layer, gap 47)
                const float k0 = w == 0 ? KS[j][i] : XS[par][ow][j][i][lane];
                const float k1 = w == 0 ? XS[par][ow][j][i][lane] : KS[j][i];
                const float q0 = w == 0 ? QS[j][i] : XS[par][ow][NT + j][i][lane];
                const float q1 = w == 0 ? XS[par][ow][NT + j][i][lane] : QS[j][i];
                KS[j][i] = k0 + k1;
                QS[j][i] = q0 + q1;
            }
        }

        MATB RB[NT];
        [[unroll]] for (uint j = 0; j < NT; j++) {
            ACC r;
            [[unroll]] for (uint i = 0; i < 8; i++) {
                const uint t = 16 * j + AROW(i);
                const float v = t0 + t < n_tokens ? vv[j][i] : 0.0;
                r[i] = v - gd(t) * KS[j][i];
            }
            TO_B(RB[j], r);
        }

        MATB DB[NT];
        [[unroll]] for (uint j = 0; j < NT; j++) {
            ACC d = ACC(0.0);
            [[unroll]] for (uint i = 0; i <= j; i++) {
                MATA a;
                LOAD_A(a, A_T, TFRAG(j, i));
                d = coopMatMulAdd(a, RB[i], d);
            }
            TO_B(DB[j], d);

            // S += K_j^T diag(dec_j) Delta_j over this wave's k blocks
            ACC ds;
            [[unroll]] for (uint i = 0; i < 8; i++) {
                ds[i] = d[i] * gd(CL + 16 * j + AROW(i));
            }
            MATB dsb;
            TO_B(dsb, ds);
            [[unroll]] for (uint q = 0; q < KH; q++) {
                MATA a;
                LOAD_A(a, A_KT, KTFRAG(w * KH + q, j));
                S[q] = coopMatMulAdd(a, dsb, S[q]);
            }

            // O_j: wave j % 2 computes and stores token block j
            if ((j & 1) == w) {
                ACC o = QS[j];
                [[unroll]] for (uint i = 0; i < 8; i++) {
                    o[i] *= scale * gd(16 * j + AROW(i));
                }
                [[unroll]] for (uint i = 0; i <= j; i++) {
                    MATA a;
                    LOAD_A(a, A_P, TFRAG(j, i));
                    o = coopMatMulAdd(a, DB[i], o);
                }
                if (t0 + CL <= n_tokens) {
                    [[unroll]] for (uint i = 0; i < 8; i++) {
                        data_dst[o_lane + (t0 + 16 * j + 2 * i) * (S_V * H)] = o[i];
                    }
                } else {
                    [[unroll]] for (uint i = 0; i < 8; i++) {
                        if (t0 + 16 * j + AROW(i) < n_tokens) {
                            data_dst[o_lane + (t0 + 16 * j + 2 * i) * (S_V * H)] = o[i];
                        }
                    }
                }
            }
        }
    }

    [[unroll]] for (uint q = 0; q < KH; q++) {
        [[unroll]] for (uint i = 0; i < 8; i++) {
            data_dst[s_off + state_base + (w * KH + q) * 16 + AROW(i)] = S[q][i];
        }
    }
}
#elif defined(USE_LDS) || CPW == 1
void main() {
    const uint lane  = gl_SubgroupInvocationID;
    const uint lr    = lane % 16;
    const uint hi    = lane / 16;
    const uint la    = 2 * lr;                       // this lane's row within a fragment tile
    const uint tid   = gl_LocalInvocationIndex;
    const uint nsplit = 8 / NW;
    const uint h     = gl_WorkGroupID.x / nsplit;
    const uint seq   = gl_WorkGroupID.y;
    const uint iq1   = h % neq1;
    const uint v0    = ((gl_WorkGroupID.x % nsplit) * NW + gl_SubgroupID) * 16;

    const uint state_base = (seq * H + h) * S_V * S_V + (v0 + lr) * S_V;
    // token-row addressing: lane part (column, half-wave row parity) + a uniform row offset
    const uint v_lane     = seq * sv3 + h * sv1 + v0 + lr + hi * sv2;
    const uint o_lane     = (seq * n_tokens * H + h) * S_V + v0 + lr + hi * (S_V * H);
    // scratch is chunk-major (all heads of a chunk adjacent), see gdn_chunk_prep.comp
    const uint qk_base4   = (seq * nch * neq1 + iq1) * (QKU / 4);
    const uint tp_base4   = (n_seqs * nch * neq1 * QKU + (seq * nch * H + h) * TPU) / 4;

    ACC S[KT];
    [[unroll]] for (uint kt = 0; kt < KT; kt++) {
        [[unroll]] for (uint i = 0; i < 8; i++) {
            S[kt][i] = data_state[state_base + kt * 16 + AROW(i)];
        }
    }

#ifdef USE_LDS
    // staging: unit u of the chunk comes from the q/k block (Kh, KhT) for u < L_T, else from the T/P block
    const uint NST = (L_N + WGT - 1) / WGT;
    uvec4 stage[(L_N + WGT - 1) / WGT];
#define STAGE_LOAD(cc) { \
        const uint qk4_ = qk_base4 + (cc) * neq1 * (QKU / 4); \
        const uint tp4_ = tp_base4 + (cc) * H * (TPU / 4); \
        [[unroll]] for (uint n = 0; n < NST; n++) { \
            const uint u = tid + WGT * n; \
            if (u < L_N) { \
                stage[n] = u < L_T ? scr4[qk4_ + L_SRC + u] : scr4[tp4_ + u - L_T]; \
            } \
        } }
    STAGE_LOAD(0)
#endif

    for (uint c = 0; c < nch; c++) {
        const uint t0  = c * CL;
        const uint qk4 = qk_base4 + c * neq1 * (QKU / 4);
#ifdef USE_LDS
        barrier();
        [[unroll]] for (uint n = 0; n < NST; n++) {
            const uint u = tid + WGT * n;
            if (u < L_N) {
                L[u] = stage[n];
            }
        }
        barrier();
        if (c + 1 < nch) {
            STAGE_LOAD(c + 1)
        }
#else
        const uint tp4 = tp_base4 + c * H * (TPU / 4);
#endif
        // V rows of this chunk, issued before phase 1 (rows past n_tokens clamp to the last row and are masked)
        float vv[NT][8];
        [[unroll]] for (uint j = 0; j < NT; j++) {
            [[unroll]] for (uint i = 0; i < 8; i++) {
                const uint t = t0 + 16 * j + 2 * i;      // uniform; the lane adds hi
                vv[j][i] = data_v[v_lane + min(t, n_tokens - 1 - hi) * sv2];
            }
        }
        const float gam_last = gd(CL - 1);

        // phase 1, all reads of the chunk-start state S: KS_j = K_j S, QS_j = Q_j S; S *= gam_last
        ACC KS[NT], QS[NT];
        [[unroll]] for (uint j = 0; j < NT; j++) {
            KS[j] = ACC(0.0);
            QS[j] = ACC(0.0);
        }
        [[unroll]] for (uint kt = 0; kt < KT; kt++) {
            MATB sb;
            TO_B(sb, S[kt]);
            S[kt] = S[kt] * gam_last;
            [[unroll]] for (uint j = 0; j < NT; j++) {
                MATA a;
                LOAD_A(a, A_K, QFRAG(j, kt));
                KS[j] = coopMatMulAdd(a, sb, KS[j]);
                LOAD_A(a, A_Q, QFRAG(j, kt));
                QS[j] = coopMatMulAdd(a, sb, QS[j]);
            }
        }

        // R_j = V_j - diag(gam) KS_j
        MATB RB[NT];
        [[unroll]] for (uint j = 0; j < NT; j++) {
            ACC r;
            [[unroll]] for (uint i = 0; i < 8; i++) {
                const uint t = 16 * j + AROW(i);
                const float v = t0 + t < n_tokens ? vv[j][i] : 0.0;
                r[i] = v - gd(t) * KS[j][i];
            }
            TO_B(RB[j], r);
        }

        MATB DB[NT];
        [[unroll]] for (uint j = 0; j < NT; j++) {
            // Delta_j = sum_{i <= j} T_ji R_i
            ACC d = ACC(0.0);
            [[unroll]] for (uint i = 0; i <= j; i++) {
                MATA a;
                LOAD_A(a, A_T, TFRAG(j, i));
                d = coopMatMulAdd(a, RB[i], d);
            }
            TO_B(DB[j], d);

            // S += K_j^T diag(dec_j) Delta_j
            ACC ds;
            [[unroll]] for (uint i = 0; i < 8; i++) {
                ds[i] = d[i] * gd(CL + 16 * j + AROW(i));
            }
            MATB dsb;
            TO_B(dsb, ds);
            [[unroll]] for (uint kt = 0; kt < KT; kt++) {
                MATA a;
                LOAD_A(a, A_KT, KTFRAG(kt, j));
                S[kt] = coopMatMulAdd(a, dsb, S[kt]);
            }

            // O_j = scale diag(gam) QS_j + sum_{i <= j} P_ji Delta_i
            ACC o = QS[j];
            [[unroll]] for (uint i = 0; i < 8; i++) {
                o[i] *= scale * gd(16 * j + AROW(i));
            }
            [[unroll]] for (uint i = 0; i <= j; i++) {
                MATA a;
                LOAD_A(a, A_P, TFRAG(j, i));
                o = coopMatMulAdd(a, DB[i], o);
            }
            if (t0 + CL <= n_tokens) {
                [[unroll]] for (uint i = 0; i < 8; i++) {
                    data_dst[o_lane + (t0 + 16 * j + 2 * i) * (S_V * H)] = o[i];
                }
            } else {
                [[unroll]] for (uint i = 0; i < 8; i++) {
                    if (t0 + 16 * j + AROW(i) < n_tokens) {
                        data_dst[o_lane + (t0 + 16 * j + 2 * i) * (S_V * H)] = o[i];
                    }
                }
            }
        }
    }

    [[unroll]] for (uint kt = 0; kt < KT; kt++) {
        [[unroll]] for (uint i = 0; i < 8; i++) {
            data_dst[s_off + state_base + kt * 16 + AROW(i)] = S[kt][i];
        }
    }
}
#else
void main() {
    const uint lane  = gl_SubgroupInvocationID;
    const uint lr    = lane % 16;
    const uint hi    = lane / 16;
    const uint la    = 2 * lr;                       // this lane's row within a fragment tile
    const uint tid   = gl_LocalInvocationIndex;
    const uint nsplit = 8 / (NW * CPW);
    const uint h     = gl_WorkGroupID.x / nsplit;
    const uint seq   = gl_WorkGroupID.y;
    const uint iq1   = h % neq1;
    const uint v0    = ((gl_WorkGroupID.x % nsplit) * NW + gl_SubgroupID) * 16 * CPW;

    uint state_base[CPW], v_lane[CPW], o_lane[CPW];
    [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
        state_base[cp] = (seq * H + h) * S_V * S_V + (v0 + 16 * cp + lr) * S_V;
        // token-row addressing: lane part (column, half-wave row parity) + a uniform row offset
        v_lane[cp]     = seq * sv3 + h * sv1 + v0 + 16 * cp + lr + hi * sv2;
        o_lane[cp]     = (seq * n_tokens * H + h) * S_V + v0 + 16 * cp + lr + hi * (S_V * H);
    }
    // scratch is chunk-major (all heads of a chunk adjacent), see gdn_chunk_prep.comp
    const uint qk_base4   = (seq * nch * neq1 + iq1) * (QKU / 4);
    const uint tp_base4   = (n_seqs * nch * neq1 * QKU + (seq * nch * H + h) * TPU) / 4;

    ACC S[CPW][KT];
    [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
        [[unroll]] for (uint kt = 0; kt < KT; kt++) {
            [[unroll]] for (uint i = 0; i < 8; i++) {
                S[cp][kt][i] = data_state[state_base[cp] + kt * 16 + AROW(i)];
            }
        }
    }

    for (uint c = 0; c < nch; c++) {
        const uint t0  = c * CL;
        const uint qk4 = qk_base4 + c * neq1 * (QKU / 4);
        const uint tp4 = tp_base4 + c * H * (TPU / 4);
        // V rows of this chunk, issued before phase 1 (rows past n_tokens clamp to the last row and are masked)
        float vv[CPW][NT][8];
        [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
            [[unroll]] for (uint j = 0; j < NT; j++) {
                [[unroll]] for (uint i = 0; i < 8; i++) {
                    const uint t = t0 + 16 * j + 2 * i;      // uniform; the lane adds hi
                    vv[cp][j][i] = data_v[v_lane[cp] + min(t, n_tokens - 1 - hi) * sv2];
                }
            }
        }
        const float gam_last = gd(CL - 1);

        // phase 1, all reads of the chunk-start state S: KS_j = K_j S, QS_j = Q_j S; S *= gam_last
        ACC KS[CPW][NT], QS[CPW][NT];
        [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
            [[unroll]] for (uint j = 0; j < NT; j++) {
                KS[cp][j] = ACC(0.0);
                QS[cp][j] = ACC(0.0);
            }
        }
        [[unroll]] for (uint kt = 0; kt < KT; kt++) {
            MATB sb[CPW];
            [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
                TO_B(sb[cp], S[cp][kt]);
                S[cp][kt] = S[cp][kt] * gam_last;
            }
            [[unroll]] for (uint j = 0; j < NT; j++) {
                MATA a;
                LOAD_A(a, A_K, QFRAG(j, kt));
                [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
                    KS[cp][j] = coopMatMulAdd(a, sb[cp], KS[cp][j]);
                }
                LOAD_A(a, A_Q, QFRAG(j, kt));
                [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
                    QS[cp][j] = coopMatMulAdd(a, sb[cp], QS[cp][j]);
                }
            }
        }

        // R_j = V_j - diag(gam) KS_j
        MATB RB[CPW][NT];
        [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
            [[unroll]] for (uint j = 0; j < NT; j++) {
                ACC r;
                [[unroll]] for (uint i = 0; i < 8; i++) {
                    const uint t = 16 * j + AROW(i);
                    const float v = t0 + t < n_tokens ? vv[cp][j][i] : 0.0;
                    r[i] = v - gd(t) * KS[cp][j][i];
                }
                TO_B(RB[cp][j], r);
            }
        }

        MATB DB[CPW][NT];
        [[unroll]] for (uint j = 0; j < NT; j++) {
            // Delta_j = sum_{i <= j} T_ji R_i
            ACC d[CPW];
            [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
                d[cp] = ACC(0.0);
            }
            [[unroll]] for (uint i = 0; i <= j; i++) {
                MATA a;
                LOAD_A(a, A_T, TFRAG(j, i));
                [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
                    d[cp] = coopMatMulAdd(a, RB[cp][i], d[cp]);
                }
            }
            MATB dsb[CPW];
            [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
                TO_B(DB[cp][j], d[cp]);
                // S += K_j^T diag(dec_j) Delta_j
                ACC ds;
                [[unroll]] for (uint i = 0; i < 8; i++) {
                    ds[i] = d[cp][i] * gd(CL + 16 * j + AROW(i));
                }
                TO_B(dsb[cp], ds);
            }
            [[unroll]] for (uint kt = 0; kt < KT; kt++) {
                MATA a;
                LOAD_A(a, A_KT, KTFRAG(kt, j));
                [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
                    S[cp][kt] = coopMatMulAdd(a, dsb[cp], S[cp][kt]);
                }
            }

            // O_j = scale diag(gam) QS_j + sum_{i <= j} P_ji Delta_i
            ACC o[CPW];
            [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
                o[cp] = QS[cp][j];
                [[unroll]] for (uint i = 0; i < 8; i++) {
                    o[cp][i] *= scale * gd(16 * j + AROW(i));
                }
            }
            [[unroll]] for (uint i = 0; i <= j; i++) {
                MATA a;
                LOAD_A(a, A_P, TFRAG(j, i));
                [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
                    o[cp] = coopMatMulAdd(a, DB[cp][i], o[cp]);
                }
            }
            [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
                if (t0 + CL <= n_tokens) {
                    [[unroll]] for (uint i = 0; i < 8; i++) {
                        data_dst[o_lane[cp] + (t0 + 16 * j + 2 * i) * (S_V * H)] = o[cp][i];
                    }
                } else {
                    [[unroll]] for (uint i = 0; i < 8; i++) {
                        if (t0 + 16 * j + AROW(i) < n_tokens) {
                            data_dst[o_lane[cp] + (t0 + 16 * j + 2 * i) * (S_V * H)] = o[cp][i];
                        }
                    }
                }
            }
        }
    }

    [[unroll]] for (uint cp = 0; cp < CPW; cp++) {
        [[unroll]] for (uint kt = 0; kt < KT; kt++) {
            [[unroll]] for (uint i = 0; i < 8; i++) {
                data_dst[s_off + state_base[cp] + kt * 16 + AROW(i)] = S[cp][kt][i];
            }
        }
    }
}
#endif
