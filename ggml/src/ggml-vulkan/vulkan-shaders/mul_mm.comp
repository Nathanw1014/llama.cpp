#define SHMEM_STRIDE (BK / 2 + SHMEM_STRIDE_PAD)

// Grouped raster (0 = off): consecutive workgroups walk RASTER_GROUP row tiles of A, then the next
// column tile of B, so a group's weight rows stay cache-resident across every column tile instead
// of streaming the whole weight matrix once per column tile.
layout(constant_id = 14) const uint RASTER_GROUP = 0;

// Manual fragment assembly needs the tiles as 32-bit words: an f16vec2 tile whose halves are consumed
// separately gets split by the optimiser back into two 16-bit LDS reads (and the dequant stores into two
// 16-bit writes), which is exactly the codegen coopMatLoad produces. A uint tile cannot be split.
#if defined(COOPMAT_MANUAL_FRAG) && !defined(DATA_A_BF16)
#define BUF_MANUAL 1
#define BUF_T uint
#define TO_BUF(v)   pack32(float16BitsToUint16(v))
#define FROM_BUF(u) uint16BitsToFloat16(unpack16(u))
#else
#define BUF_T FLOAT_TYPEV2
#define TO_BUF(v)   (v)
#define FROM_BUF(u) (u)
#endif
shared BUF_T buf_a[BM * SHMEM_STRIDE];
shared BUF_T buf_b[BN * SHMEM_STRIDE];

#if defined(DATA_A_Q5_K) || defined(DATA_A_Q4_K)
// Per-tile-row (d, m) for the current BK chunk. A BK=32 chunk of one row never
// straddles a q4_K/q5_K sub-block (8 idx span 14 of a 16-wide half), so the
// packed 6-bit scale extraction can run once per row per superblock instead of
// once per 4-weight load (8x redundant across the loading lanes). Both types
// share the dm + scales[12] block prefix, so one fill serves both.
// Always on for mul_mat_id; there is deliberately no toggle. It had one, and it
// cost us a shipped correctness bug: the macro was set to 0 in July on a bad
// measurement but every guard was #ifdef, so the cache stayed compiled in and that
// is the state that shipped and was benchmarked for five weeks. 83f901d73 then put
// one of the three guards on #if, which disabled the refill below while the two
// readers in mul_mm_funcs.glsl kept reading scache_dm. Every q4_K/q5_K expert
// weight was dequantized against a scale nothing wrote, and v0.7.4 emitted a single
// repeated token on every MoE with q4_K/q5_K experts (reverted in 5d8c07b44).
// Re-measured 2026-09-04 with the guard form held constant across both arms:
// 3 models x {pp512@ub512, pp2048@ub2048} x {d0, d16384}, 3 launches per arm. The
// cache wins or ties 12 of 12 cells and loses none - +5 to +8% at ub512, neutral to
// +2% at ub2048, holding at depth, on Qwen3.6-35B UD-Q5_K_XL / UD-Q4_K_XL and
// Ornith-1.5-35B Q4_K_M. The 2026-07-28 number has its sign inverted at ub512 and
// calls a tie a -20% loss. To A/B this again, revert this commit rather than adding
// a macro back: the three sites live in two files and must move together.
// The #else branches in mul_mm_funcs.glsl serve variants without SCACHE_DM; since
// 2026-09-13 the dense q4_K/q5_K variant uses the cache too (ISA audit: the per-load
// scale decode was ~90 of ~340 VALU per BK step in the wave32 coopmat loop).
// 8 sub-block (d, m) pairs per tile row, refilled once per superblock (every
// 8th BK=32 iteration) so 7 of 8 iterations pay no fill or extra barrier.
// 2026-09-13: extended to the dense variant (it was mul_mat_id only); the readers key on SCACHE_DM.
#define SCACHE_DM 1
// f16 pairs (4 KB at BM=128): the f32 version (8 KB) pushed the dense 128x128 pipeline's LDS from
// 26.6 KB to 34.8 KB, i.e. from 2 workgroups per CU to 1, and cost -36% on q4_K m4096 n512 k14336
// (2026-09-13). d = d_super * sc is a 17-bit product rounded to 11 bits here, at most half an ulp of
// the f16 tile store that follows it.
#if defined(FLOAT16)
#define SCACHE_T f16vec2
#else
#define SCACHE_T vec2   // the _fp32 fallback variants have no float16 types
#endif
shared SCACHE_T scache_dm[BM * 8];
#endif

