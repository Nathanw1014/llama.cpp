// The 256x256 XL tier (ggml_vk_mm_xl_ok): 512 threads = 16 wave32 subgroups on one CU, so ACO's budget
// is 192 VGPRs, and each subgroup's 4x4 f32 accumulators take 128 of them. Both measures below are folded
// from spec constants; every other tile compiles to the same ISA as before (checked per type).
// (1) In mm_compute_tile the compiler keeps the four B fragments of a k step live across all four rows
//     (one LDS read each instead of four): 32 VGPRs, and the tile spilled (q4_K 5, q5_K 9, q6_K 15,
//     q8_0 7, iq4_xs 6 VGPRs), reloading them from scratch every K step. A subgroup-scope shared-memory
//     barrier after each row forces the B fragments to be re-read per row: 2.4x the fragment LDS reads,
//     no spill for any type. Standalone dispatcher, x the l tile at 17408x2048x5120, 5120x2048x17408
//     and 10240x2048x2560 (2026-09-25): q6_K 1.17-1.32 -> 1.30-1.42, q8_0 1.11-1.15 -> 1.15-1.20,
//     q5_K 1.15-1.16 -> 1.14-1.16; q4_K 1.07-1.10 (spilling) -> 1.17-1.18.
// (2) XL_IDX_BASE, in main(): keep only the row-0 tile addressing in registers.
#if defined(EXP_XL_OFF)
const bool XL_TILE = false;
#else
const bool XL_TILE = BM * BN >= 256 * 256;
#endif
#ifdef COOPMAT
// coopmat state at file scope so the K loop body can be a function (the register-prefetch loop is
// unrolled by two and calls it three times; keeping one copy of the fragment loads + WMMAs)
const uint cm_rows = WM / TM;
const uint cm_cols = WN / TN;
coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> cm_a;
coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> cm_b;
coopmat<ACC_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> cm_sums[cm_rows * cm_cols];
uint cm_warp_r, cm_warp_c;
void mm_compute_tile() {
    [[unroll]] for (uint i = 0; i < BK; i += TK) {
        [[unroll]] for (uint cm_row = 0; cm_row < cm_rows; cm_row++) {
            // Load from shared into cache
#if defined(BUF_MANUAL)
            // RDNA3 fragment layout, measured on gfx1151 (~/cm1-layout-probe): an A lane L holds row
            // L%16 with its 16 k elements as m[0..15]; a B lane L holds column L%16 with its 16 k
            // elements as m[0..15]. Both LDS tiles keep k contiguous in packed f16 pairs, so a
            // fragment is eight 32-bit LDS reads per lane written straight into the matrix elements.
            // RADV lowers coopMatLoad into 16 separate 16-bit reads plus 16-bit moves to pair them
            // (128 ds_read_u16_d16 + 128 v_mov_b16 per k step on q4_K); this bypasses that.
            {
                const uint frag_lane = gl_SubgroupInvocationID % 16;
                const uint base = a_shmem_index(cm_warp_r * WM + cm_row * TM + frag_lane, i / 2);
                [[unroll]] for (uint e = 0; e < 8; e++) {
                    const FLOAT_TYPEV2 v = FROM_BUF(buf_a[base + e]);
                    cm_a[2 * e]     = v.x;
                    cm_a[2 * e + 1] = v.y;
                }
            }
#else
            coopMatLoad(cm_a, buf_a, a_shmem_index(cm_warp_r * WM + cm_row * TM, i / 2), a_shmem_stride(), gl_CooperativeMatrixLayoutRowMajor);
#endif

            [[unroll]] for (uint cm_col = 0; cm_col < cm_cols; cm_col++) {
#if defined(BUF_MANUAL)
                {
                    const uint frag_lane = gl_SubgroupInvocationID % 16;
                    const uint base = (cm_warp_c * WN + cm_col * TN + frag_lane) * SHMEM_STRIDE + i / 2;
                    [[unroll]] for (uint e = 0; e < 8; e++) {
                        const FLOAT_TYPEV2 v = FROM_BUF(buf_b[base + e]);
                        cm_b[2 * e]     = v.x;
                        cm_b[2 * e + 1] = v.y;
                    }
                }
#else
                coopMatLoad(cm_b, buf_b, (cm_warp_c * WN + cm_col * TN) * SHMEM_STRIDE + i / 2, SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
#endif

                cm_sums[cm_col * cm_rows + cm_row] = coopMatMulAdd(cm_a, cm_b, cm_sums[cm_col * cm_rows + cm_row]);
            }
            // XL: re-read the B fragments for every row (see XL_TILE)
            if (XL_TILE) { subgroupMemoryBarrierShared(); }
        }
    }
}
#endif

// Register-direct A for MUL_MAT_ID (REG_A spec constant, host gate GGML_VK_MMID_REGA): each wave32 subgroup owns
// WM = 16 rows and all BN columns, so one A fragment feeds BN/16 WMMAs. A lane loads its own row's quant bits one
// K step ahead and dequantizes straight into the fragment elements (gfx11 layout: lane L holds row L % 16, k 0..15
// as elements 0..15, lanes 16..31 a copy), so A never goes through shared memory and needs no barrier. B is staged
// through shared memory as before. Aligned (prefetch) pipelines only; iq3_xxs for now.
layout(constant_id = 15) const uint REG_A = 0;
#if defined(MUL_MAT_ID) && defined(COOPMAT) && defined(BUF_MANUAL) && defined(A_PREFETCH) && LOAD_VEC_A == 8 && (defined(DATA_A_IQ3_XXS) || defined(DATA_A_IQ4_NL))
#define MMID_REGA 1
struct rega_raw_t { uvec4 q; uint d; };
#if defined(DATA_A_IQ3_XXS)
#define REGA_BLK_K 256
// q.x: grid bytes 0..3, q.y: grid bytes 4..7, q.z: sign/scale dword, q.w: d bits (the lane's row, sub-block ib32)
rega_raw_t rega_fetch(const uint pos_a, const uint row_off) {
    const uint sb   = (pos_a / 32 + row_off) * 98;
    const uint ib32 = (pos_a / 4) % 8;
    const uint q    = (sb + 2 + 8 * ib32) / 2;
    const uint so   = (sb + 66 + 4 * ib32) / 2;
    return rega_raw_t(uvec4(uint(data_a_u16[q])      | (uint(data_a_u16[q + 1]) << 16),
                            uint(data_a_u16[q + 2])  | (uint(data_a_u16[q + 3]) << 16),
                            uint(data_a_u16[so])     | (uint(data_a_u16[so + 1]) << 16),
                            uint(data_a_u16[sb / 2])), 0u);
}
#else
#define REGA_BLK_K 32
// q: the block's 16 nibble bytes (low nibbles k 0..15, high k 16..31), d: d bits
rega_raw_t rega_fetch(const uint pos_a, const uint row_off) {
    const uint base = (pos_a / 4 + row_off) * 18;
    const bool odd  = ((base + 2) & 2) != 0;
    return rega_raw_t(uvec4(unpack8b(fetch8(base + 2), odd), unpack8b(fetch8(base + 10), odd)), uint(data_a_u16[base / 2]));
}
#endif
// k 16*h .. 16*h+15 of the sub-block into an A fragment
void rega_build(const rega_raw_t raw, const uint h, inout coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a) {
#if defined(DATA_A_IQ3_XXS)
    const float db = unpackHalf2x16(raw.q.w).x * 0.5 * (0.5 + float(raw.q.z >> 28));
    const uint g = h == 0 ? raw.q.x : raw.q.y;
    [[unroll]] for (uint j = 0; j < 2; j++) {
        const uint s7 = bitfieldExtract(raw.q.z, int(7 * (2 * h + j)), 7);
        const uint s8 = s7 | ((bitCount(s7) & 1) << 7);
        const vec4 v0 = db * vec4(unpack8(iq3xxs_grid[(g >> (16 * j)) & 0xFF]));
        const vec4 v1 = db * vec4(unpack8(iq3xxs_grid[(g >> (16 * j + 8)) & 0xFF]));
        const vec4 m0 = vec4(1.0) - 2.0 * vec4(uvec4(s8, s8 >> 1, s8 >> 2, s8 >> 3) & 1u);
        const vec4 m1 = vec4(1.0) - 2.0 * vec4(uvec4(s8 >> 4, s8 >> 5, s8 >> 6, s8 >> 7) & 1u);
        const vec4 a0 = v0 * m0;
        const vec4 a1 = v1 * m1;
        a[8 * j + 0] = FLOAT_TYPE(a0.x); a[8 * j + 1] = FLOAT_TYPE(a0.y);
        a[8 * j + 2] = FLOAT_TYPE(a0.z); a[8 * j + 3] = FLOAT_TYPE(a0.w);
        a[8 * j + 4] = FLOAT_TYPE(a1.x); a[8 * j + 5] = FLOAT_TYPE(a1.y);
        a[8 * j + 6] = FLOAT_TYPE(a1.z); a[8 * j + 7] = FLOAT_TYPE(a1.w);
    }
#else
    const float d = unpackHalf2x16(raw.d).x;
    [[unroll]] for (uint w = 0; w < 4; w++) {
        const uint nb = (raw.q[w] >> (4 * h)) & 0x0F0F0F0F;
        a[4 * w + 0] = FLOAT_TYPE(d * float(kvalues_iq4nl[nb & 0xFF]));
        a[4 * w + 1] = FLOAT_TYPE(d * float(kvalues_iq4nl[(nb >> 8) & 0xFF]));
        a[4 * w + 2] = FLOAT_TYPE(d * float(kvalues_iq4nl[(nb >> 16) & 0xFF]));
        a[4 * w + 3] = FLOAT_TYPE(d * float(kvalues_iq4nl[nb >> 24]));
    }
#endif
}
// cm_rows (WM / 16) A fragments per subgroup share every B fragment read from shared memory
#define REGA_MAX_ROWS 2
void rega_compute(const rega_raw_t raw[REGA_MAX_ROWS]) {
    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> ar[REGA_MAX_ROWS];
    [[unroll]] for (uint h = 0; h < 2; h++) {
        [[unroll]] for (uint r = 0; r < cm_rows; r++) {
            rega_build(raw[r], h, ar[r]);
        }
        const uint frag_lane = gl_SubgroupInvocationID % 16;
        [[unroll]] for (uint cm_col = 0; cm_col < cm_cols; cm_col++) {
            const uint base = (cm_warp_c * WN + cm_col * TN + frag_lane) * SHMEM_STRIDE + 8 * h;
            [[unroll]] for (uint e = 0; e < 8; e++) {
                const FLOAT_TYPEV2 v = FROM_BUF(buf_b[base + e]);
                cm_b[2 * e]     = v.x;
                cm_b[2 * e + 1] = v.y;
            }
            [[unroll]] for (uint r = 0; r < cm_rows; r++) {
                cm_sums[cm_col * cm_rows + r] = coopMatMulAdd(ar[r], cm_b, cm_sums[cm_col * cm_rows + r]);
            }
        }
    }
}
// REG_A == 3 (two A fragments per subgroup): lanes 0..15 decode the first fragment's row, lanes 16..31 the
// second's, and the halves are swapped with one xor-16 shuffle per packed pair (v_permlanex16 territory), so every
// lane loads and dequantizes one row instead of two.
void rega_compute_split(const rega_raw_t raw) {
    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> ar[2];
    const bool lo = gl_SubgroupInvocationID < 16;
    [[unroll]] for (uint h = 0; h < 2; h++) {
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> mine;
        rega_build(raw, h, mine);
        [[unroll]] for (uint e = 0; e < 8; e++) {
            const uint pm = packFloat2x16(f16vec2(mine[2 * e], mine[2 * e + 1]));
            const uint po = subgroupShuffleXor(pm, 16);
            const f16vec2 v0 = unpackFloat2x16(lo ? pm : po);
            const f16vec2 v1 = unpackFloat2x16(lo ? po : pm);
            ar[0][2 * e] = v0.x; ar[0][2 * e + 1] = v0.y;
            ar[1][2 * e] = v1.x; ar[1][2 * e + 1] = v1.y;
        }
        const uint frag_lane = gl_SubgroupInvocationID % 16;
        [[unroll]] for (uint cm_col = 0; cm_col < cm_cols; cm_col++) {
            const uint base = (cm_warp_c * WN + cm_col * TN + frag_lane) * SHMEM_STRIDE + 8 * h;
            [[unroll]] for (uint e = 0; e < 8; e++) {
                const FLOAT_TYPEV2 v = FROM_BUF(buf_b[base + e]);
                cm_b[2 * e]     = v.x;
                cm_b[2 * e + 1] = v.y;
            }
            cm_sums[cm_col * cm_rows]     = coopMatMulAdd(ar[0], cm_b, cm_sums[cm_col * cm_rows]);
            cm_sums[cm_col * cm_rows + 1] = coopMatMulAdd(ar[1], cm_b, cm_sums[cm_col * cm_rows + 1]);
        }
    }
}
#endif

