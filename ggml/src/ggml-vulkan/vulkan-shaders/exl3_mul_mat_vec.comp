#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

// EXL3 dot kernel (few rows), see ggml/exl3/README.md and the HIP dot kernel in ggml-cuda/exl3.cu (adapted from
// exllamav3's RDNA GEMV, MIT). y = H(xh W_hat) * svh/128 with xh = H(x*suh) from exl3_rotate.comp.
// A workgroup computes T = 2 adjacent 16-column tiles for M rows, its waves splitting K. Each lane decodes its 8 weights
// of a tile in registers to the exact fp16 codebook values and multiplies them with the f32 activations (f32
// accumulation). The last workgroup to finish a 128-column segment applies H and svh/128 to it (arrival counters,
// zeroed by the rotation). Wave32 only (pipelines pinned to subgroup size 32).

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint BLOCK_SIZE = 256;
layout(constant_id = 4) const uint M = 8;

#define T 2
const uint NWARPS = BLOCK_SIZE / 32;

layout(push_constant) uniform parameter {
    uint k;
    uint n;
    uint rows;
    uint tq_stride;   // ID: uint32 words of one expert's trellis
    // FUSED: the input rotation in the kernel (x strides and offset in floats, as exl3_rotate.comp)
    uint ne1;
    uint ne2;
    uint s1;
    uint s2;
    uint s3;
    uint x_off;
    uint n_used;
    uint ids_s1;
    uint w_on;        // ID: dst row p times w[p] (the fused MUL by the router weights)
    uint glu_on;      // ID: x is the gate of a SwiGLU with up (EXL3_MUL_MAT_ID reading GLU, fused)
} p;

layout(binding = 0) readonly buffer TR { uint data_t[]; };
#ifdef FUSED
// FUSED: x itself; each workgroup rotates its rows into LDS (M*k <= FUSED_XH floats). The arrival counters are
// persistent: the last workgroup of a segment resets its counter. ID1: one token, group g = pair g, expert ids[g]
layout(binding = 1) readonly buffer X  { float data_x[]; };
layout(binding = 5) readonly buffer SU { float16_t data_su[]; };
#ifdef ID1
layout(binding = 6) readonly buffer IDS { int data_ids[]; };
#endif
#define FUSED_XH 4096
shared float sh_xh[FUSED_XH];
#else
layout(binding = 1) readonly buffer XH { vec2 data_xh[]; };
#endif
layout(binding = 2) readonly buffer SV { float16_t data_sv[]; };
layout(binding = 3) coherent buffer D  { float data_d[]; };
layout(binding = 4) coherent buffer CN { uint data_c[]; };
#if defined(ID) || defined(ID1)
layout(binding = 7) readonly buffer WT { float data_w[]; };
#endif
#if defined(FUSED) && defined(ID1)
#define GLU_BINDING
layout(binding = 8) readonly buffer UP { float data_up[]; };
#endif
#ifdef FUSED

// the input element i: x, or with p.glu_on the SwiGLU of gate x and up, computed as swiglu.comp computes it
float exl3_xin(const uint i) {
#ifdef GLU_BINDING
    if (p.glu_on != 0) {
        const float a = data_x[i];
        return a / (1.0f + exp(-a)) * data_up[i];
    }
#endif
    return data_x[i];
}
#endif
#ifdef ID
// ID: group g = (expert, first row, rows) of exl3_route.comp; row r of the scratch is pair ord[r] = its dst row
layout(binding = 5) readonly buffer GRP { uint data_grp[]; };
layout(binding = 6) readonly buffer ORD { uint data_ord[]; };
#endif

#define EXL3_FWHT
#include "exl3_common.glsl"

uint dst_row(const uint r) {
#ifdef ID
    return data_ord[r];
#else
    return r;
#endif
}

shared float sh_red[NWARPS*T*M*16];
shared uint  sh_old;

void main() {
    const uint lane    = gl_SubgroupInvocationID;
    const uint warp    = gl_SubgroupID;
    const uint tid     = gl_LocalInvocationIndex;
    const uint tn      = p.n / 16;
    const uint tile_n0 = gl_WorkGroupID.x*T;
    const uint group   = gl_WorkGroupID.y;
#ifdef ID
    const uint e          = data_grp[3*group];
    const uint row0       = data_grp[3*group + 1];
    const uint rows_valid = data_grp[3*group + 2];
    if (rows_valid == 0) {
        return;
    }
    const uint tbase  = e*p.tq_stride;
    const uint svbase = e*p.n;
#elif defined(ID1)
    const uint row0       = group;
    const uint rows_valid = 1;
    const uint e          = uint(data_ids[(group / p.n_used)*p.ids_s1 + group % p.n_used]);
    const uint tbase  = e*p.tq_stride;
    const uint svbase = e*p.n;
#else
    const uint row0       = group*M;
    const uint rows_valid = min(M, p.rows - row0);
    const uint tbase  = 0;
    const uint svbase = 0;
#endif

#ifdef FUSED
    // xh = H(x*suh) of this workgroup's rows into LDS, one wave per (row, 128 block), as exl3_rotate.comp
    {
        const uint segs = p.k / 128;
        for (uint w = warp; w < rows_valid*segs; w += NWARPS) {
            const uint r   = w / segs;
            const uint seg = w % segs;
#ifdef ID1
            const uint pr  = row0 + r;
            const uint xb  = p.x_off + ((pr % p.n_used) % p.ne1)*p.s1 + (pr / p.n_used)*p.s2 + seg*128;
            const uint sb  = e*p.k + seg*128;
#else
            const uint ri  = row0 + r;
            const uint xb  = p.x_off + (ri % p.ne1)*p.s1 + ((ri / p.ne1) % p.ne2)*p.s2 + (ri / (p.ne1*p.ne2))*p.s3 + seg*128;
            const uint sb  = seg*128;
#endif
            float v[4];
            [[unroll]] for (uint i = 0; i < 4; ++i) {
                precise float t = exl3_xin(xb + i*32 + lane)*float(data_su[sb + i*32 + lane]);
                v[i] = t;
            }
            exl3_fwht128(v, lane);
            [[unroll]] for (uint i = 0; i < 4; ++i) {
                sh_xh[r*p.k + seg*128 + i*32 + lane] = v[i];
            }
        }
        barrier();
    }
#endif

    const uint k_tiles = p.k / 16;
    const uint chunk   = (k_tiles + NWARPS - 1) / NWARPS;
    const uint kb0     = min(warp*chunk, k_tiles);
    const uint kb1     = min(kb0 + chunk, k_tiles);

    float acc_a[T*M];
    float acc_b[T*M];
    [[unroll]] for (uint i = 0; i < T*M; ++i) {
        acc_a[i] = 0.0f;
        acc_b[i] = 0.0f;
    }

    // xh as vec2: (x[r0], x[r0 + 1]) of a k-tile at kt*8 + (lane & 3), (x[r0 + 8], x[r0 + 9]) 4 further
    uint xrow[M];
    [[unroll]] for (uint r = 0; r < M; ++r) {
#ifdef FUSED
        xrow[r] = min(r, rows_valid - 1)*(p.k/2) + (lane & 3);
#else
        xrow[r] = (row0 + min(r, rows_valid - 1))*(p.k/2) + (lane & 3);
#endif
    }

    for (uint kt = kb0; kt < kb1; ++kt) {
        f16vec2 f[T][4];
        [[unroll]] for (uint t = 0; t < T; ++t) {
            exl3_lane_decode(tbase + (kt*tn + tile_n0 + t)*EXL3_TILE_U32, lane, f[t]);
        }
        [[unroll]] for (uint r = 0; r < M; ++r) {
#ifdef FUSED
            const vec2 xa = vec2(sh_xh[2*(xrow[r] + kt*8)], sh_xh[2*(xrow[r] + kt*8) + 1]);
            const vec2 xb = vec2(sh_xh[2*(xrow[r] + kt*8 + 4)], sh_xh[2*(xrow[r] + kt*8 + 4) + 1]);
#else
            const vec2 xa = data_xh[xrow[r] + kt*8];
            const vec2 xb = data_xh[xrow[r] + kt*8 + 4];
#endif
            [[unroll]] for (uint t = 0; t < T; ++t) {
                float a = acc_a[t*M + r];
                float b = acc_b[t*M + r];
                a = fma(xa.x, float(f[t][0].x), a);
                a = fma(xa.y, float(f[t][0].y), a);
                a = fma(xb.x, float(f[t][1].x), a);
                a = fma(xb.y, float(f[t][1].y), a);
                b = fma(xa.x, float(f[t][2].x), b);
                b = fma(xa.y, float(f[t][2].y), b);
                b = fma(xb.x, float(f[t][3].x), b);
                b = fma(xb.y, float(f[t][3].y), b);
                acc_a[t*M + r] = a;
                acc_b[t*M + r] = b;
            }
        }
    }

    // quad q holds the 16 tile rows of columns q (acc_a) and q + 8 (acc_b) between its four lanes
    [[unroll]] for (uint i = 0; i < T*M; ++i) {
        acc_a[i] += subgroupShuffleXor(acc_a[i], 1);
        acc_a[i] += subgroupShuffleXor(acc_a[i], 2);
        acc_b[i] += subgroupShuffleXor(acc_b[i], 1);
        acc_b[i] += subgroupShuffleXor(acc_b[i], 2);
    }
    if ((lane & 3) == 0) {
        const uint q = lane >> 2;
        [[unroll]] for (uint i = 0; i < T*M; ++i) {
            sh_red[(warp*T*M + i)*16 + q]     = acc_a[i];
            sh_red[(warp*T*M + i)*16 + q + 8] = acc_b[i];
        }
    }
    barrier();

    // sum the waves, store y before the output rotation
    for (uint e = tid; e < T*M*16; e += BLOCK_SIZE) {
        const uint i = e / 16;
        const uint c = e % 16;
        const uint t = i / M;
        const uint r = i % M;
        if (r < rows_valid) {
            float s = 0.0f;
            for (uint w = 0; w < NWARPS; ++w) {
                s += sh_red[(w*T*M + i)*16 + c];
            }
            data_d[dst_row(row0 + r)*p.n + (tile_n0 + t)*16 + c] = s;
        }
    }
    memoryBarrierBuffer();
    barrier();

    // the last workgroup of the segment's 8 tiles rotates it
    const uint seg = tile_n0 / 8;
    if (tid == 0) {
        sh_old = atomicAdd(data_c[group*(p.n/128) + seg], T);
    }
    barrier();
    if (sh_old + T != 8) {
        return;
    }
#ifdef FUSED
    if (tid == 0) {
        data_c[group*(p.n/128) + seg] = 0;
    }
#endif
    memoryBarrierBuffer();
    for (uint r = warp; r < rows_valid; r += NWARPS) {
        const uint base = dst_row(row0 + r)*p.n + seg*128;
        float v[4];
        [[unroll]] for (uint i = 0; i < 4; ++i) {
            v[i] = data_d[base + i*32 + lane];
        }
        exl3_fwht128(v, lane);
        [[unroll]] for (uint i = 0; i < 4; ++i) {
            data_d[base + i*32 + lane] = v[i]*(float(data_sv[svbase + seg*128 + i*32 + lane])*(1.0f/128.0f));
#if defined(ID) || defined(ID1)
            if (p.w_on != 0) {
                data_d[base + i*32 + lane] *= data_w[dst_row(row0 + r)];
            }
#endif
        }
    }
}
